# Shared Expenses V2 — single documented source of environment configuration.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Phase 1 uses ONLY the Supabase public/anon client and SSR server client.
# Do NOT add SUPABASE_SERVICE_ROLE_KEY (or any other secret) here in Phase 1.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trusted app origin used to build server-side redirect URLs (e.g. password
# reset links). Must NOT be derived from request headers (Host/
# X-Forwarded-Host are client-controllable) — always read from this env var.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
