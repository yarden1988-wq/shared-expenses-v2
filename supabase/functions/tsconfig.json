{
  // Typecheck-only config for the Deno Edge Functions (`npm run typecheck:functions`).
  // Deno itself ignores this file; _tests/deno-shim.d.ts declares the few Deno APIs used.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
